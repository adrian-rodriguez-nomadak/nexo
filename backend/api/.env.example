PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexo
DATABASE_SSL=false
CORS_ORIGIN=http://localhost:3000,https://nexo-chi-nine.vercel.app
AUTH_EXCHANGE_SECRET=replace-with-a-long-random-secret
OPENAI_API_KEY=replace-with-an-openai-api-key
OPENAI_ASSISTANT_MODEL=gpt-5.6-sol
OPENAI_VISION_MODEL=gpt-5.6-sol
NEXO_TEXT_PROVIDER=groq
NEXO_TEXT_API_URL=https://api.groq.com/openai/v1
NEXO_TEXT_API_KEY=replace-with-a-groq-api-key
NEXO_TEXT_MODEL=llama-3.1-8b-instant
OMI_API_KEY=omi_dev_replace-with-your-key
